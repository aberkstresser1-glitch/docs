generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  DRAFT
  AWAITING_PARTIES
  AWAITING_EXTERNAL_STEP
  READY_TO_FINALIZE
  FINALIZED
  VOID
}

enum ParticipantRole {
  BUYER
  SELLER
  WITNESS
  OTHER
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  createdDocuments  Document[]            @relation("DocumentCreator")
  participations    DocumentParticipant[]
  createdVersions   DocumentVersion[]     @relation("VersionCreator")
  signatures        Signature[]           @relation("Signer")
  auditEvents       AuditEvent[]          @relation("AuditActor")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  key         String
  name        String
  category    String
  version     Int
  schema      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]

  @@unique([key, version])
  @@index([key, active])
}

model Document {
  id                 String         @id @default(cuid())
  title              String
  templateId         String?
  templateKey        String
  templateVersion    Int
  status             DocumentStatus @default(DRAFT)
  creatorId          String
  sellerJurisdiction String?
  buyerJurisdiction  String?
  currentVersion     Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  finalizedAt        DateTime?
  voidedAt           DateTime?

  creator      User                  @relation("DocumentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  template     DocumentTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  participants DocumentParticipant[]
  versions     DocumentVersion[]
  auditEvents  AuditEvent[]

  @@index([creatorId, updatedAt])
  @@index([status, updatedAt])
  @@index([templateKey, templateVersion])
}

model DocumentParticipant {
  id          String          @id @default(cuid())
  documentId  String
  userId      String?
  role        ParticipantRole
  roleIndex   Int             @default(0)
  email       String?
  displayName String?
  invitedAt   DateTime?
  acceptedAt  DateTime?
  completedAt    DateTime?
  inviteTokenHash String?         @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  signatures Signature[]

  @@unique([documentId, role, roleIndex])
  @@index([userId, updatedAt])
  @@index([email])
}

model DocumentVersion {
  id          String    @id @default(cuid())
  documentId  String
  version     Int
  payload     Json
  hash        String?
  pdfPath     String?
  immutable   Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  finalizedAt DateTime?

  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User        @relation("VersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signatures Signature[]

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@index([hash])
}

model Signature {
  id                String   @id @default(cuid())
  documentVersionId String
  participantId     String
  signerUserId      String?
  typedName         String
  signatureStyle    String
  consentText       String
  documentHash      String
  signedAt          DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  documentVersion DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  participant     DocumentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  signer          User?               @relation("Signer", fields: [signerUserId], references: [id], onDelete: SetNull)

  @@unique([documentVersionId, participantId])
  @@index([signerUserId, signedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  documentId  String
  actorUserId String?
  eventType   String
  metadata    Json?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([actorUserId, createdAt])
}
